<launch>
<!--启动乌龟gui-->
    <node pkg="turtlesim" type="turtlesim_node" name="turtle1" output="screen" />
    <node pkg="turtlesim" type="turtle_teleop_key" name="key" output="screen" />

    <node pkg="tf04_test" type="test01_new_turtle" name="turtle2" output="screen" />
    //发布turtle1和turtle2的相对坐标系
    <node pkg="tf04_test" type="test02_pub_turtle" name="pub1" args="turtle1" output="screen" />
    <node pkg="tf04_test" type="test02_pub_turtle" name="pub2" args="turtle2" output="screen" />
    //订阅turtle1和turtle2的位置信息并发布相对坐标系生成速度消息
    <node pkg="tf04_test" type="test03_sub_turtle" name="sub1" args="turtle1" output="screen" />
    <node pkg="tf04_test" type="test03_sub_turtle" name="sub2" args="turtle2" output="screen" />
</launch>